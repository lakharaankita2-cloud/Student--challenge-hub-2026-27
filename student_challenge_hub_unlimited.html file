      <div class="stat"><b id="streak">3</b>Days</div>
    </div>
  </div>
</section>

<section id="challenges">
  <h2 class="section-title">🔥 Today's Challenges</h2>
  <div class="grid">
    <div class="card challenge">
      <div class="icon">💻</div><span class="tag">Coding</span>
      <h3>HTML Starter</h3><p>Ek simple personal profile page banao.</p>
      <div class="progress"><div style="width:35%"></div></div>
      <button class="btn" onclick="completeChallenge(this)">Complete +50</button>
    </div>
    <div class="card challenge">
      <div class="icon">🧠</div><span class="tag">Knowledge</span>
      <h3>Brain Quiz</h3><p>5 quick questions solve karke score dekho.</p>
      <div class="progress"><div style="width:55%"></div></div>
      <button class="btn" onclick="document.getElementById('quiz-area').scrollIntoView({behavior:'smooth'})">Take Quiz</button>
    </div>
    <div class="card challenge">
      <div class="icon">🎯</div><span class="tag">Daily</span>
      <h3>Daily 5 Questions</h3><p>Kisi bhi subject ka quick quiz complete karo.</p>
      <div class="progress"><div style="width:20%"></div></div>
      <button class="btn" onclick="document.getElementById('quiz-area').scrollIntoView({behavior:'smooth'})">Start Quiz</button>
    </div>
    <div class="card challenge">
      <div class="icon">📚</div><span class="tag">Study</span>
      <h3>30-Min Focus</h3><p>30 minutes distraction-free study complete karo.</p>
      <div class="progress"><div id="focusBar" style="width:0%"></div></div>
      <button class="btn" onclick="startFocus()">Start Timer</button>
    </div>
  </div>
</section>

<section id="progress">
  <h2 class="section-title">📊 Your Progress</h2>
  <div class="card">
    <h3>Weekly Goal</h3><p>4 of 7 challenges completed</p>
    <div class="progress"><div style="width:57%"></div></div>
    <p><b>Keep going!</b> You are building a great learning habit.</p>
  </div>
</section>

<section id="quiz-area">
  <h2 class="section-title">🧠 All Subjects Quiz</h2>
  <div class="grid" style="margin-bottom:22px">
    <button class="card" onclick="setSubject('Science')" style="cursor:pointer;border:0;text-align:left">🔬 <b>Science</b><br><small>Physics, Chemistry, Biology</small></button>
    <button class="card" onclick="setSubject('Maths')" style="cursor:pointer;border:0;text-align:left">➗ <b>Mathematics</b><br><small>Numbers, algebra, geometry</small></button>
    <button class="card" onclick="setSubject('English')" style="cursor:pointer;border:0;text-align:left">📖 <b>English</b><br><small>Grammar and vocabulary</small></button>
    <button class="card" onclick="setSubject('GK')" style="cursor:pointer;border:0;text-align:left">🌍 <b>General Knowledge</b><br><small>India, world and facts</small></button>
    <button class="card" onclick="setSubject('Computer')" style="cursor:pointer;border:0;text-align:left">💻 <b>Computer</b><br><small>HTML, coding and basics</small></button>
