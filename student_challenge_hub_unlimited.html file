  extraQuestions[s].forEach(x=>questionSets[s].push({q:x[0],o:x[1],a:x[2]}));
});

// Add hundreds of generated, mathematically/factually safe quiz items.
for(let n=1;n<=120;n++){
  const a=n+2,b=(n%9)+2;
  questionSets.Maths.push({q:`${a} + ${b} = ?`,o:[String(a+b-1),String(a+b),String(a+b+1),String(a+b+2)],a:1});
  questionSets.Maths.push({q:`${a} × ${b} = ?`,o:[String(a*b-1),String(a*b),String(a*b+1),String(a*b+2)],a:1});
}
for(let n=1;n<=100;n++){
  questionSets.GK.push({q:`गिनती में ${n} के बाद कौन सा अंक आता है?`,o:[String(n),String(n+1),String(n+2),String(n+3)],a:1});
}

let subject="Science", questions=[], qi=0, score=0, quizSession=0;
const usedBySubject={};

function buildUnlimitedQuiz(s){
  const bank=questionSets[s].slice();
  usedBySubject[s] ||= new Set();
  // Shuffle without repeating until the complete bank has been used.
  if(usedBySubject[s].size>=bank.length) usedBySubject[s].clear();
  const available=bank.map((_,i)=>i).filter(i=>!usedBySubject[s].has(i));
  for(let i=available.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[available[i],available[j]]=[available[j],available[i]];}
  questions=available.map(i=>{usedBySubject[s].add(i);return bank[i];});
  qi=0; score=0; quizSession++;
}

function setSubject(s){
  subject=s;
  buildUnlimitedQuiz(s);
  document.getElementById("quiz").style.display="block";
  document.getElementById("quiz").scrollIntoView({behavior:"smooth",block:"center"});
  loadQuiz();
}

function loadQuiz(){
  document.getElementById("qCount").textContent=`${subject} • Question ${qi+1} • Unlimited Quiz`;
  document.getElementById("question").textContent=questions[qi].q;
  document.getElementById("result").textContent="";
  document.getElementById("nextBtn").style.display="none";
  const box=document.getElementById("options"); box.innerHTML="";
  questions[qi].o.forEach((x,i)=>{
    const b=document.createElement("button");
    b.className="option"; b.textContent=x;
    b.onclick=()=>answer(i,b); box.appendChild(b);
  });
}

function answer(i,b){
  document.querySelectorAll(".option").forEach(x=>x.disabled=true);
  if(i===questions[qi].a){
    score++; b.style.borderColor="#16a34a";
    document.getElementById("result").textContent="✅ सही जवाब!";
    points+=5;
  }else{
    b.style.borderColor="#dc2626";
    document.getElementById("result").textContent="❌ गलत जवाब।";
  }
  document.getElementById("points").textContent=points;
  document.getElementById("nextBtn").style.display="inline-block";
}

function nextQuestion(){
  qi++;
  if(qi<questions.length){loadQuiz();}
  else{
    // Never ends: refill with a fresh randomized round automatically.
    document.getElementById("quiz").innerHTML=
      `<h3>🎉 Round Complete!</h3>
       <p style="margin:10px 0">Score: <b>${score}/${questions.length}</b></p>
       <p style="margin-bottom:15px">Unlimited Quiz जारी रखें — अगला round नई questions के साथ।</p>
       <button class="btn" onclick="continueUnlimited()">Continue Quiz</button>`;
  }
}

function continueUnlimited(){
  document.getElementById("quiz").innerHTML=
    `<div id="qCount"></div><div class="question" id="question"></div>
     <div id="options"></div><div id="result"></div>
     <button class="btn" id="nextBtn" style="display:none;margin-top:10px" onclick="nextQuestion()">Next</button>`;
  buildUnlimitedQuiz(subject); loadQuiz();
}

buildUnlimitedQuiz(subject);
loadQuiz();
</script>
