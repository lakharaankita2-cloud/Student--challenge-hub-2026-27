<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Challenge Hub</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f4f7ff;color:#172033;line-height:1.5}
header{background:linear-gradient(135deg,#4f46e5,#7c3aed);color:white;padding:18px 7%;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:5}
.logo{font-size:22px;font-weight:800}.logo span{color:#fbbf24}
nav a{color:white;text-decoration:none;margin-left:20px;font-weight:600}
.hero{padding:70px 7%;background:linear-gradient(135deg,#eef2ff,#faf5ff);display:flex;align-items:center;justify-content:space-between;gap:40px}
.hero-text{max-width:650px}.badge{display:inline-block;background:#e0e7ff;color:#4338ca;padding:7px 12px;border-radius:20px;font-weight:700;margin-bottom:15px}
h1{font-size:clamp(38px,6vw,64px);line-height:1.05;margin-bottom:18px}
.hero p{font-size:18px;color:#4b5563;margin-bottom:25px}
.btn{border:0;background:#4f46e5;color:white;padding:13px 20px;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer}
.btn:hover{background:#4338ca}
.hero-card{background:white;padding:28px;border-radius:22px;box-shadow:0 15px 45px #4f46e522;min-width:270px}
.hero-card .big{font-size:55px;text-align:center}.hero-card h3{text-align:center;margin:8px}
section{padding:55px 7%}.section-title{text-align:center;font-size:32px;margin-bottom:30px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}
.card{background:white;border-radius:18px;padding:22px;box-shadow:0 8px 25px #17203312}
.card h3{margin:10px 0}.card p{color:#667085;margin-bottom:15px}
.icon{font-size:35px}.tag{display:inline-block;padding:5px 9px;background:#eef2ff;color:#4338ca;border-radius:8px;font-size:12px;font-weight:bold}
.progress{height:10px;background:#e5e7eb;border-radius:10px;overflow:hidden;margin:12px 0}.progress div{height:100%;background:#4f46e5}
.challenge{display:flex;flex-direction:column}.challenge .btn{margin-top:auto}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:25px}
.stat{text-align:center;background:#f8fafc;border-radius:14px;padding:15px}.stat b{display:block;font-size:25px;color:#4f46e5}
#quiz{display:none;max-width:700px;margin:0 auto}.question{font-size:21px;font-weight:700;margin:15px 0}
.option{width:100%;text-align:left;background:#f8fafc;border:2px solid #e5e7eb;padding:12px;border-radius:10px;margin:7px 0;cursor:pointer;font-size:15px}.option:hover{border-color:#6366f1}
#result{margin-top:15px;font-weight:bold}
footer{text-align:center;background:#111827;color:#d1d5db;padding:25px}
@media(max-width:700px){header{padding:15px 5%}nav a{margin-left:8px;font-size:13px}.hero{padding:45px 5%;flex-direction:column;align-items:flex-start}section{padding:40px 5%}.stats{grid-template-columns:1fr}}
</style>
</head>
<body>

<header>
  <div class="logo">Student<span>Challenge</span> 🚀</div>
  <nav><a href="#challenges">Challenges</a><a href="#progress">Progress</a><a href="#quiz-area">Quiz</a></nav>
</header>

<main>
<section class="hero">
  <div class="hero-text">
    <span class="badge">🏆 Learn • Compete • Grow</span>
    <h1>Turn Your Skills Into a Challenge.</h1>
