    <div id="qCount"></div>
    <div class="question" id="question"></div>
    <div id="options"></div>
    <div id="result"></div>
    <button class="btn" id="nextBtn" style="display:none;margin-top:10px" onclick="nextQuestion()">Next</button>
  </div>
</section>
</main>

<footer>© 2026 Student Challenge Hub • Made for learners 🚀</footer>

<script>
let points=120, done=2, streak=3;

function completeChallenge(btn){
  if(btn.dataset.done) return;
  btn.dataset.done="1";
  btn.textContent="✓ Completed";
  points+=50; done++;
  document.getElementById("points").textContent=points;
  document.getElementById("done").textContent=done;
  alert("Challenge completed! 🎉 +50 points");
}

let timer=null, seconds=0;
function startFocus(){
  if(timer){alert("Focus timer already running!");return}
  seconds=0;
  timer=setInterval(()=>{
    seconds++;
    document.getElementById("focusBar").style.width=Math.min(seconds/1800*100,100)+"%";
    if(seconds>=1800){
      clearInterval(timer); timer=null;
      points+=50;
      document.getElementById("points").textContent=points;
      alert("30-minute focus challenge completed! 🎉 +50 points");
    }
  },1000);
  alert("Focus timer started! Study for 30 minutes. 📚");
}

